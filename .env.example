# =============================================================================
# AgoraMeet — Environment variables
# =============================================================================
# Copy this file to `.env.local` and replace every value below:
#
#     cp .env.example .env.local
#
# Next.js automatically loads `.env.local` (it is git-ignored and must never be
# committed). Variables WITHOUT the `NEXT_PUBLIC_` prefix are server-only and are
# never sent to the browser. Variables WITH the `NEXT_PUBLIC_` prefix are inlined
# into the client bundle at build time — never put a secret in one.
#
# All values come from the Agora Console: https://console.agora.io/
# =============================================================================


# -----------------------------------------------------------------------------
# Agora project credentials      (server-only • REQUIRED for every meeting)
# -----------------------------------------------------------------------------
# Read by /api/agora/token to mint RTC tokens (lib/agora.ts) and reused by the
# AI Mentor agent (lib/agora-conversational-ai.ts). The App ID is also returned
# to the browser in the token response so the client SDK can join the channel —
# the App ID is not a secret. The App Certificate signs tokens and MUST stay on
# the server.

# App ID              (Console -> Projects -> your project)
AGORA_APP_ID=your_app_id_here

# App Certificate     (Console -> Projects -> Primary Certificate) — SECRET
AGORA_APP_CERTIFICATE=your_app_certificate_here


# -----------------------------------------------------------------------------
# Agora REST API credentials     (server-only • REQUIRED for the AI Mentor)
# -----------------------------------------------------------------------------
# Basic-auth pair for the Conversational AI Agent REST API, used only by
# /api/agora/agent/{start,stop}. Not needed to join a plain video meeting.
# Console -> RESTful API -> "Add a secret".

# REST key / Customer ID        — SECRET
AGORA_REST_KEY=your_rest_key_here

# REST secret / Customer secret — SECRET
AGORA_REST_SECRET=your_rest_secret_here


# -----------------------------------------------------------------------------
# Conversational AI Agent        (server-only)
# -----------------------------------------------------------------------------
# The pipeline defines the agent's ASR + LLM + TTS behavior.
# Console -> Conversational AI.

# Pipeline ID                    (REQUIRED for the AI Mentor)
AGORA_AGENT_PIPELINE_ID=your_pipeline_id_here

# RTC UID the voice agent joins as. Optional — defaults to 999999 in code.
# If you change this, set NEXT_PUBLIC_AGORA_AI_AGENT_UID (below) to the SAME
# value, or client-side speech detection won't exclude the agent's own audio.
AGORA_AI_AGENT_UID=999999


# -----------------------------------------------------------------------------
# LiveAvatar                     (server-only • see note on REQUIRED)
# -----------------------------------------------------------------------------
# Renders the agent as an animated talking-head video that joins the channel as
# a second RTC UID publishing video.
#
# NOTE — inconsistency in the current code:
#   * lib/agora-conversational-ai.ts treats the avatar as OPTIONAL and degrades
#     to an audio-only agent when these two vars are unset.
#   * BUT app/api/agora/agent/start/route.ts lists AGORA_AVATAR_ID and
#     LIVEAVATAR_API_KEY in its required set and refuses to start the agent
#     without them.
#   So today both are effectively REQUIRED to launch the AI Mentor. (Reconciling
#   this is deferred — it changes AI-start behavior, which is checkpoint 2.)

# LiveAvatar API key             — SECRET
LIVEAVATAR_API_KEY=your_liveavatar_api_key_here

# Avatar identifier to render    (from your LiveAvatar / Agora account)
AGORA_AVATAR_ID=your_avatar_id_here

# RTC UID the avatar video joins as. Optional — defaults to 999998 in code.
AGORA_AVATAR_UID=999998


# -----------------------------------------------------------------------------
# Client-side configuration      (NEXT_PUBLIC_ • exposed to the browser)
# -----------------------------------------------------------------------------
# Read in components/MeetingRoom.tsx so the client can ignore the agent's own
# audio when detecting whether a human is speaking. Keep this equal to
# AGORA_AI_AGENT_UID above. Optional — defaults to 999999. Not a secret (a UID).
NEXT_PUBLIC_AGORA_AI_AGENT_UID=999999
